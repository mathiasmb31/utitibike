
{
    "policy_version": 2404.1,
    "policy_groups": [
        "networking",
        "connectivity",
        "content_exchange",
        "content_exchange_source",
        "keep-display-on",
        "location",
        "audio"
    ],
    "read_path": [
        "/etc/deviceinfo/devices/",
        "/etc/deviceinfo/devices/*.yaml",
        "/proc/device-tree/model",
        "/sys/firmware/devicetree/base/model",
        "/etc/machine-info"
    ]
}


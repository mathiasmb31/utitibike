#!/bin/bash
# Règle Mathias 2026-11-06 — NE JAMAIS POUSSER LES .click (TOUS projets)
# + garde-fou taille 2026-11-08 (blob > MAX_PUSH_FILE_MB Mo, défaut 100).
# Activer : git config core.hooksPath githooks
# La vérification d'identité dans l'historique reste une étape manuelle
# (commande de contrôle documentée dans AGENTS.md).
ZERO=0000000000000000000000000000000000000000
MAX_MB="${MAX_PUSH_FILE_MB:-100}"
MAX_BYTES=$((MAX_MB * 1024 * 1024))
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue
    if [ "$remote_sha" = "$ZERO" ]; then
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    # Règle Mathias (tous projets) : aucun ID device dans un contenu publié.
    BLOCK_ID="$(printf '57606%s79' 5)"
    OLD_ID="$(printf '71b90%s' fee)"
    if git log -p $range | grep -aE '^\+[^+]' | grep -aqE "$BLOCK_ID|$OLD_ID"; then
        echo "ERREUR (confidentialité) : ID device interdit dans ce push." >&2
        exit 1
    fi
    bad=$(git rev-list --objects $range | awk '{print $2}' | grep '\.click$' | head -5)
    if [ -n "$bad" ]; then
        echo "ERREUR (règle Mathias) : ce push contient des .click :" >&2
        echo "$bad" >&2
        echo "Les .click restent en local (reconstructibles). Push filtré :" >&2
        echo "  base-de-connaissances/restauration-workspace-vibe-2026-11-06.md" >&2
        rc=1
    fi
    big=$(git rev-list --objects $range | git cat-file --batch-check='%(objecttype) %(objectsize) %(rest)' \
          | awk -v max="$MAX_BYTES" '$1=="blob" && $2>max {print $3, $2}' | head -5)
    if [ -n "$big" ]; then
        echo "ERREUR (garde-fou taille, ${MAX_MB} Mo max) :" >&2
        echo "$big" | awk -v m=1048576 '{printf "  %s : %.1f Mo\n", $1, $2/m}' >&2
        echo "  Surcharger : MAX_PUSH_FILE_MB=<Mo> git push" >&2
        rc=1
    fi
done
exit $rc

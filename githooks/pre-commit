#!/bin/bash
# Règle Mathias (tous projets) : JAMAIS d'ID device dans un contenu publié.
BLOCK_ID="$(printf '57606%s79' 5)"
OLD_ID="$(printf '71b90%s' fee)"
if git diff --cached --text | grep -aE '^\+[^+]' | grep -aqE "$BLOCK_ID|$OLD_ID"; then
    echo "ERREUR (confidentialité) : ID device interdit dans le commit." >&2
    echo "  Utiliser ADB_DEVICE / <serial> à la place." >&2
    exit 1
fi
# Garde-fou taille (règle Mathias 2026-11-08) — tout fichier NON .click
# au-delà de MAX_COMMIT_FILE_MB Mo (défaut 50) est refusé au commit.
# Les .click sont autorisés localement (git add -f) et bloqués au push.
MAX_MB="${MAX_COMMIT_FILE_MB:-50}"
MAX_BYTES=$((MAX_MB * 1024 * 1024))
tmp=$(mktemp)
git ls-files -s | awk '{print $2, $4}' | while read -r sha path; do
    case "$path" in *.click|*.click.*) continue ;; esac
    size=$(git cat-file -s "$sha" 2>/dev/null) || continue
    [ "$size" -gt "$MAX_BYTES" ] && printf '%s %s\n' "$path" "$size" >> "$tmp"
done
if [ -s "$tmp" ]; then
    echo "ERREUR (garde-fou taille, ${MAX_MB} Mo max hors .click) :" >&2
    awk -v m=1048576 '{printf "  %s : %.1f Mo\n", $1, $2/m}' "$tmp" >&2
    echo "  Surcharger : MAX_COMMIT_FILE_MB=<Mo> git commit" >&2
    rm -f "$tmp"
    exit 1
fi
rm -f "$tmp"
exit 0
